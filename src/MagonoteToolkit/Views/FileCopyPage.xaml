<Page
    x:Class="MagonoteToolkit.Views.FileCopyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bh="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:MagonoteToolkit.Resources"
    xmlns:viewmodels="clr-namespace:MagonoteToolkit.ViewModels"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewmodels:FileCopyPageViewModel />
    </Page.DataContext>

    <Grid Margin="10,10,10,10" HorizontalAlignment="Center">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.CopySource}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            Width="500"
                            Margin="5,5,10,5"
                            Text="{Binding CopySourcePath}">
                            <bh:Interaction.Triggers>
                                <bh:EventTrigger EventName="PreviewDragOver">
                                    <bh:InvokeCommandAction Command="{Binding FilePathPreviewDragOverCommand}" PassEventArgsToCommand="True" />
                                </bh:EventTrigger>
                                <bh:EventTrigger EventName="Drop">
                                    <bh:InvokeCommandAction Command="{Binding CopySourcePathDropCommand}" PassEventArgsToCommand="True" />
                                </bh:EventTrigger>
                            </bh:Interaction.Triggers>
                        </TextBox>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.CopyDestination}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            Width="500"
                            Margin="5,5,10,5"
                            Text="{Binding CopyDestinationPath}">
                            <bh:Interaction.Triggers>
                                <bh:EventTrigger EventName="PreviewDragOver">
                                    <bh:InvokeCommandAction Command="{Binding FilePathPreviewDragOverCommand}" PassEventArgsToCommand="True" />
                                </bh:EventTrigger>
                                <bh:EventTrigger EventName="Drop">
                                    <bh:InvokeCommandAction Command="{Binding CopyDestinationPathDropCommand}" PassEventArgsToCommand="True" />
                                </bh:EventTrigger>
                            </bh:Interaction.Triggers>
                        </TextBox>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.CopyConditions}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox
                                Margin="10,5,5,5"
                                Content="{x:Static resources:Strings.ContainsText}"
                                IsChecked="{Binding IsEnableCopyConditionContainsText}" />
                            <TextBox
                                Width="500"
                                Margin="5,5,10,5"
                                Text="{Binding CopyConditionContainsText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox
                                Margin="10,5,5,5"
                                Content="{x:Static resources:Strings.WithinPeriod}"
                                IsChecked="{Binding IsEnableCopyConditionWithinPeriod}" />
                            <DatePicker
                                Width="200"
                                Margin="5,5,5,5"
                                SelectedDate="{Binding CopyConditionStartDate}" />
                            <TextBlock
                                Margin="5,5,5,5"
                                VerticalAlignment="Center"
                                Text="～" />
                            <DatePicker
                                Width="200"
                                Margin="5,5,10,5"
                                SelectedDate="{Binding CopyConditionEndDate}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.CopyOptions}">
                    <StackPanel>
                        <CheckBox
                            Margin="10,5,5,5"
                            Content="{x:Static resources:Strings.CopyTheDirectoryStructure}"
                            IsChecked="{Binding IsCopyTheDirectoryStructure}" />
                    </StackPanel>
                </GroupBox>

                <Button
                    Margin="10,5,10,5"
                    HorizontalAlignment="Stretch"
                    Command="{Binding CopyCommand}"
                    Content="{x:Static resources:Strings.ExecuteCopy}"
                    IsEnabled="{Binding IsOperationEnable}" />

                <Grid Margin="10,5,10,5">
                    <ProgressBar
                        VerticalAlignment="Stretch"
                        IsIndeterminate="{Binding IsProgressIndeterminate}"
                        Maximum="{Binding ProgressMaximum}"
                        Minimum="0"
                        Value="{Binding ProgressValue}" />
                    <TextBlock
                        Margin="0,5,0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding ProgressMessage}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
