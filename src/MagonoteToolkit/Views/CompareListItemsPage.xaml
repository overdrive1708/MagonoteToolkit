<Page
    x:Class="MagonoteToolkit.Views.CompareListItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:MagonoteToolkit.Resources"
    xmlns:viewmodels="clr-namespace:MagonoteToolkit.ViewModels"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewmodels:CompareListItemsPageViewModels />
    </Page.DataContext>

    <Grid Margin="10,10,10,10" HorizontalAlignment="Center">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.BeforeChange}">
                    <TextBox
                        Width="400"
                        Height="300"
                        Margin="10,5,10,5"
                        AcceptsReturn="True"
                        HorizontalScrollBarVisibility="Auto"
                        IsEnabled="{Binding IsOperationEnable}"
                        Text="{Binding BeforeListItems}"
                        VerticalScrollBarVisibility="Auto" />
                </GroupBox>
                <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.AfterChange}">
                    <TextBox
                        Width="400"
                        Height="300"
                        Margin="10,5,10,5"
                        AcceptsReturn="True"
                        HorizontalScrollBarVisibility="Auto"
                        IsEnabled="{Binding IsOperationEnable}"
                        Text="{Binding AfterListItems}"
                        VerticalScrollBarVisibility="Auto" />
                </GroupBox>
            </StackPanel>

            <Button
                Margin="10,5,10,5"
                HorizontalAlignment="Stretch"
                Command="{Binding ComparisonCommand}"
                Content="{x:Static resources:Strings.ExecuteComparison}"
                IsEnabled="{Binding IsOperationEnable}" />

            <StackPanel Orientation="Horizontal">
                <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.Add}">
                    <TextBox
                        Width="400"
                        Height="300"
                        Margin="10,5,10,5"
                        AcceptsReturn="True"
                        HorizontalScrollBarVisibility="Auto"
                        IsEnabled="{Binding IsOperationEnable}"
                        Text="{Binding AddListItems}"
                        VerticalScrollBarVisibility="Auto" />
                </GroupBox>
                <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.Delete}">
                    <TextBox
                        Width="400"
                        Height="300"
                        Margin="10,5,10,5"
                        AcceptsReturn="True"
                        HorizontalScrollBarVisibility="Auto"
                        IsEnabled="{Binding IsOperationEnable}"
                        Text="{Binding DeleteListItems}"
                        VerticalScrollBarVisibility="Auto" />
                </GroupBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
