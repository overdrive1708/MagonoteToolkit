<Page
    x:Class="MagonoteToolkit.Views.AITranslationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:MagonoteToolkit.Resources"
    xmlns:viewmodels="clr-namespace:MagonoteToolkit.ViewModels"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewmodels:AITranslationPageViewModel />
    </Page.DataContext>

    <Grid Margin="10,10,10,10">
        <StackPanel>
            <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.ModelToBeUsed}">
                <ComboBox
                    Margin="10,5,10,5"
                    ItemsSource="{Binding ModelList}"
                    SelectedItem="{Binding SelectedModel}" />
            </GroupBox>

            <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.TranslationInputText}">
                <StackPanel>
                    <ComboBox
                        Margin="10,5,10,5"
                        ItemsSource="{Binding TranslationInputLanguageList}"
                        SelectedItem="{Binding TranslationInputLanguage}" />
                    <TextBox
                        Height="200"
                        Margin="10,5,10,5"
                        AcceptsReturn="True"
                        HorizontalScrollBarVisibility="Auto"
                        Text="{Binding TranslationInputText}"
                        VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.TranslationOutputText}">
                <StackPanel>
                    <ComboBox
                        Margin="10,5,10,5"
                        ItemsSource="{Binding TranslationOutputLanguageList}"
                        SelectedItem="{Binding TranslationOutputLanguage}" />
                    <TextBox
                        Height="200"
                        Margin="10,5,10,5"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        Text="{Binding TranslationOutputText}"
                        VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </GroupBox>

            <Button
                Margin="10,5,10,5"
                HorizontalAlignment="Stretch"
                Command="{Binding TranslationCommand}"
                Content="{x:Static resources:Strings.ExecuteTranslation}"
                IsEnabled="{Binding IsOperationEnable}" />
        </StackPanel>
    </Grid>
</Page>
