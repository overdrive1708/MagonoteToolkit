<Page
    x:Class="MagonoteToolkit.Views.StringCharcodeConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:MagonoteToolkit.Resources"
    xmlns:viewmodels="clr-namespace:MagonoteToolkit.ViewModels"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewmodels:StringCharcodeConvertPageViewModel />
    </Page.DataContext>

    <Grid Margin="10,10,10,10">
        <StackPanel>
            <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.ConvertOption}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="10,5,5,5"
                            VerticalAlignment="Center"
                            Text="{x:Static resources:Strings.CharCode}" />
                        <ComboBox
                            Margin="10,5,10,5"
                            DisplayMemberPath="Value"
                            ItemsSource="{Binding CharcodeTypeList}"
                            SelectedValue="{Binding SelectedCharcodeType}"
                            SelectedValuePath="Key" />
                        <TextBlock
                            Margin="10,5,5,5"
                            VerticalAlignment="Center"
                            Text="{x:Static resources:Strings.SeparatorChar}" />
                        <ComboBox
                            Margin="10,5,10,5"
                            DisplayMemberPath="Value"
                            ItemsSource="{Binding SeparatorTypeList}"
                            SelectedValue="{Binding SelectedSeparatorType}"
                            SelectedValuePath="Key" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.String}">
                <TextBox
                    Height="200"
                    Margin="10,5,10,5"
                    AcceptsReturn="True"
                    HorizontalScrollBarVisibility="Auto"
                    Text="{Binding ConvertString}"
                    VerticalScrollBarVisibility="Auto" />
            </GroupBox>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    Margin="10,5,10,5"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ConvertStringToCharcodeCommand}"
                    Content="{x:Static resources:Strings.ExecuteConvertStringToCharcode}" />
                <Button
                    Margin="10,5,10,5"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ConvertCharcodeToStringCommand}"
                    Content="{x:Static resources:Strings.ExecuteConvertCharcodeToString}" />
            </StackPanel>

            <GroupBox Margin="10,5,10,5" Header="{x:Static resources:Strings.CharCode}">
                <TextBox
                    Height="200"
                    Margin="10,5,10,5"
                    AcceptsReturn="True"
                    HorizontalScrollBarVisibility="Auto"
                    Text="{Binding ConvertCharCode}"
                    VerticalScrollBarVisibility="Auto" />
            </GroupBox>
        </StackPanel>
    </Grid>
</Page>
